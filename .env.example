# --- Servidor (app.py) ---
# HOST=127.0.0.1
# PORT=8000
# TIMEOUT=60

# URL publica da aplicacao (sem barra no final), usada em callbacks e links
# de resultados quando o servico fica detras de um proxy/dominio.
# PUBLIC_BASE_URL=

# --- Processamento de PDF / rede neural (config.py) ---
# PDF_WORKERS=2
# TABLE_MODEL=models/uepg_table_detector.pt
# FIELD_MODEL=models/field_detector.pt
# NEURAL_THRESHOLD=0.7
# NEURAL_MIN_CONFIDENCE=0.65
# NEURAL_ENABLED=true
# NEURAL_REQUIRED=false

# --- Banco de dados (database.py) ---
MONGO_URI=mongodb://localhost:27017/pdf_neural

# --- Autenticacao Keycloak (auth.py) ---
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/pdf-neural
KEYCLOAK_AUDIENCE=pdf-neural-api
KEYCLOAK_ADMIN_ROLE=pdf-admin
# Derivados do issuer se omitidos; sobrescreva se o Keycloak estiver em outro host
# (ex.: dentro do Docker Desktop, use host.docker.internal mantendo o issuer publico acima).
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/pdf-neural/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/pdf-neural/protocol/openid-connect/token
# KEYCLOAK_ADMIN_URL=http://localhost:8080/admin/realms/pdf-neural

# Client confidencial (client_credentials) usado pelo backend para chamar a Admin API
# do Keycloak (ex.: API Keys e criacao de usuarios). Sem isso, esses recursos administrativos falham.
KEYCLOAK_ADMIN_CLIENT_ID=pdf-neural-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=troque_pelo_secret_do_client

# Apenas para referencia/uso manual com scripts/configure_keycloak.py
# (nao sao lidas automaticamente pelo backend em runtime).
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=troque_pela_senha_do_admin_master

# --- Dev local (scripts/dev.sh e frontend/vite.config.ts) ---
# BACKEND_URL deve apontar para o mesmo HOST/PORT configurados acima; o proxy do
# Vite usa esse valor para encaminhar /api, /auth, /jobs, /docs e /openapi.json.
# BACKEND_URL=http://127.0.0.1:8000

# --- Docker Compose local (docker-compose.override.yml) ---
# Porta publicada no host ao rodar `docker compose up` localmente. Ignorada pelo
# Coolify, que aplica somente docker-compose.yml (sem publicar porta no host).
# HOST_PORT=8000

# URL do servico Gotenberg acessivel pela API.
# Em Docker Compose, use o nome do servico na rede Docker (ex.: http://gotenberg:3000).
# GOTENBERG_URL=http://localhost:3000
