MONGO_URI=mongodb://localhost:27017/pdf_neural
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/pdf-neural
KEYCLOAK_AUDIENCE=pdf-neural-api
KEYCLOAK_ADMIN_ROLE=pdf-admin
# Dentro do Docker Desktop, use a URL abaixo para buscar as chaves mantendo o issuer publico acima.
# KEYCLOAK_JWKS_URL=http://host.docker.internal:8080/realms/pdf-neural/protocol/openid-connect/certs
