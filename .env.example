MONGO_URI=mongodb://localhost:27017/pdf_neural
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/pdf-neural
KEYCLOAK_AUDIENCE=pdf-neural-api
KEYCLOAK_ADMIN_ROLE=pdf-admin
KEYCLOAK_ADMIN_URL=http://localhost:8080/admin/realms/pdf-neural
KEYCLOAK_ADMIN_CLIENT_ID=pdf-neural-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=troque_pelo_secret_do_client
# Dentro do Docker Desktop, use a URL abaixo para buscar as chaves mantendo o issuer publico acima.
# KEYCLOAK_JWKS_URL=http://host.docker.internal:8080/realms/pdf-neural/protocol/openid-connect/certs

# Usados por ./scripts/dev.sh: HOST/PORT configuram o backend Python,
# BACKEND_URL aponta o proxy do Vite (frontend) para o mesmo HOST/PORT.
# HOST=127.0.0.1
# PORT=8000
# BACKEND_URL=http://127.0.0.1:8000
